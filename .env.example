PAYLOAD_SECRET=change-me
# Turso (production). Omit for local file DB.
DATABASE_URI=file:./iso-kms.db
DATABASE_AUTH_TOKEN=
# Vercel Blob (evidence storage)
BLOB_READ_WRITE_TOKEN=
# Bearer token the daily audit-pack sweep requires (set on Vercel).
CRON_SECRET=
# The app's own origin. Audit-pack builds call back into this address carrying
# the requester's session cookie, so it is never taken from the request host in
# production — pack builds throw without it. See ADR-0015.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
